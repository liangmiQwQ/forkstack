{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["void/env", "vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "void/db": ["./.void/db.d.ts"],
      "void/routes": ["./.void/routes.d.ts"],
      "void/queues": ["./.void/queues.d.ts"],
      "@auth-schema": ["./.void/better-auth-schema.ts"],
      "@schema": ["./db/schema.ts"]
    }
  },
  "include": ["db", "src", "pages", "routes", "middleware", "queues", "tests", "auth.ts", "env.ts"]
}
